    {
      "rule_id": "jyotisha.varahamihira.brhajjataka.02.05.benefic_malefic_classification",
      "tradition_id": "indian_jyotisha",
      "school_id": "varahamihira_brhajjataka_chapter2_alignment",
      "period": "varahamihira_text_in_1979_sanskrit_input_aligned_to_1905_translation",
      "domain": "natal",
      "scope": {"work": "Brhajjataka", "technique": "planetary_benefic_malefic_classification"},
      "conditions": {
        "all": [
          {"fact": "classical_planet", "operator": "in", "value": ["sun", "moon", "mars", "mercury", "jupiter", "venus", "saturn"]},
          {"fact": "moon_phase_half", "operator": "known"},
          {"fact": "mercury_conjunction_context", "operator": "known_when_planet_is_mercury"}
        ]
      },
      "conclusion": {
        "type": "conditional_classification",
        "malefic": ["sun", "mars", "saturn", "waning_moon", "mercury_joined_to_any_malefic_in_this_list"],
        "benefic": ["jupiter", "venus", "waxing_moon", "mercury_joined_to_any_benefic_in_this_list"],
        "unresolved": ["mercury_unjoined", "mercury_joined_to_both_categories", "exact_phase_boundary"]
      },
      "priority": null,
      "exceptions": [
        "The waxing-Moon benefic classification follows the contrast implied by the verse and Aiyar's note; a Sanskrit reviewer must confirm the syntax.",
        "The passage does not resolve Mercury joined simultaneously to benefic and malefic planets or Mercury with no relevant conjunction.",
        "Rahu and Ketu are not added to this seven-planet classification from a different source."
      ],
      "conflicts_with": ["generic_fixed_mercury_benefic_classification", "generic_nodes_added_to_brhajjataka_02.05"],
      "source_passages": [
        {"edition_id": "jyotisha_varahamihira_brhajjataka_gretil", "work": "Brhajjataka", "section": "Grahabheda", "location": "BJ_02.05a-b", "verification": "sanskrit_verse_and_stable_id_inspected"},
        {"edition_id": "jyotisha_varahamihira_brhajjataka_aiyar_1905_archive", "work": "The Brihat Jataka", "section": "Chapter II, stanza 5 and NOTES", "location": "OCR aligned to printed chapter and stanza; page image review pending", "verification": "translation_and_commentary_inspected_with_ambiguity_retained"}
      ],
      "evidence_grade": "B",
      "publication_limit": "Expose the phase and conjunction evidence. If Mercury's classification is unresolved, downstream rules requiring a benefic/malefic label must fan out or abstain.",
      "review_status": "verse_aligned_syntax_phase_boundary_and_facsimile_review_pending"
    },
