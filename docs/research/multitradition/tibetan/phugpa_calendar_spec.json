    "moon_equation":"interpolate_moon_table(28*moon_anomaly)",
    "sun_equation":"interpolate_sun_table(12*euclidean_fraction(mean_sun - 1/4))",
    "true_date":"mean_date + moon_equation/60 - sun_equation/60",
    "integer_jdn":"floor(true_date)",
    "skipped":"integer_jdn(d) equals integer_jdn(d-1)",
    "repeated":"integer_jdn(d) minus integer_jdn(d-1) equals 2; first occurrence is integer_jdn(d)-1",
    "weekday":"euclidean_mod(integer_jdn + 2, 7) with 0=Saturday through 6=Friday",
