# --- SERVER SECURITY (CRITICAL) ---
# A random string (~32+ chars) to sign user sessions.
# Generate one: openssl rand -hex 32
JWT_SECRET=change_this_to_a_random_secret_string
ADMIN_SECRET_KEY=change_this_to_a_random_admin_key

# --- PAYMENT (STRIPE) ---
# Stripe Secret Key (sk_live_... or sk_test_...)
STRIPE_SECRET_KEY=sk_test_...
# Stripe Webhook Secret (whsec_...) - Found in Stripe Dashboard > Developers > Webhooks
STRIPE_WEBHOOK_SECRET=whsec_...
# B2B Subscription Price IDs (Stripe Dashboard > Products > Price ID)
# Leave blank to disable checkout for that tier until configured.
# Scholar: $9.99/mo, $99/yr — unlimited readings, PDF export, no API
STRIPE_PRICE_SCHOLAR_MONTHLY=price_...
STRIPE_PRICE_SCHOLAR_ANNUAL=price_...
# Practitioner: $29/mo, $290/yr — everything + B2B API (100 calls/day)
STRIPE_PRICE_PRACTITIONER_MONTHLY=price_...
STRIPE_PRICE_PRACTITIONER_ANNUAL=price_...
# Studio: custom — unlimited API, team seats
STRIPE_PRICE_STUDIO_MONTHLY=price_...
STRIPE_PRICE_STUDIO_ANNUAL=price_...

# One-time audit report price IDs (Stripe Dashboard > Products > Price ID)
# Used for direct report purchases (non-subscription).
STRIPE_PRICE_CALIBRATION_ONETIME=price_...
STRIPE_PRICE_FULL_ONETIME=price_...

# Trial defaults (days)
TRIAL_DAYS_DEFAULT=14
# Revenue gate:
# - pilot: disable paid checkout globally while building product fit
# - live: enable paid checkout
SALES_MODE=live

# Promo: temporarily unlock "individual" (non-premium) readings for free-tier users.
# Keep rate limits in place; frontend will suppress paywall UI when meta.promo_unlocked=true.
# PROMO_FREE_INDIVIDUAL_READINGS=true
# PROMO_FREE_INDIVIDUAL_READINGS_UNTIL=2026-03-31

# --- EMAIL SERVICE (REQUIRED) ---
# Option 1: SendGrid (Recommended)
SENDGRID_API_KEY=SG.xxxxxxxx.xxxxxxx
SENDER_EMAIL=noreply@yourdomain.com

# Option 2: SMTP (Gmail, Outlook, AWS SES)
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=587
# SMTP_USER=your_email@gmail.com
# SMTP_PASS=your_app_password

# --- AI MODEL (OPENROUTER) ---
OPENROUTER_API_KEY=sk-or-v1-...
OPENROUTER_MODEL=google/gemini-3-flash-preview

# --- DEPLOYMENT ---
SITE_BASE_URL=https://traditional-astrology.com
CACHE_DIR=/tmp/astrology_cache
CORS_ORIGINS=http://localhost:3000,https://traditional-astrology.com,https://www.traditional-astrology.com,https://astrology-engine-central-7387.azurewebsites.net
